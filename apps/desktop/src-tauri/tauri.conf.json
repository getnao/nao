{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "nao",
	"mainBinaryName": "nao",
	"version": "../package.json",
	"identifier": "io.getnao.desktop",
	"build": {
		"beforeDevCommand": "npm run dev:ui",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build:ui",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"withGlobalTauri": false,
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self'",
				"img-src": "'self' data:",
				"font-src": "'self'",
				"connect-src": "ipc: http://ipc.localhost",
				"object-src": "'none'",
				"base-uri": "'none'",
				"form-action": "'none'",
				"frame-src": "'none'",
				"frame-ancestors": "'none'"
			},
			"devCsp": null,
			"freezePrototype": false,
			"capabilities": ["local-ui"]
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg", "nsis", "appimage", "deb"],
		"category": "Productivity",
		"shortDescription": "nao analytics agent",
		"longDescription": "Desktop app for nao Cloud and self-hosted nao servers.",
		"publisher": "nao Labs",
		"homepage": "https://getnao.io",
		"copyright": "© nao Labs",
		"createUpdaterArtifacts": false,
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": {
			"minimumSystemVersion": "11.0",
			"hardenedRuntime": true,
			"entitlements": "./entitlements.plist"
		},
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		},
		"linux": {
			"appimage": {
				"bundleMediaFramework": false
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
			"endpoints": ["https://github.com/getnao/nao/releases/download/desktop-latest/latest.json"],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
