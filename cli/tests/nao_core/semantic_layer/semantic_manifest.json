{
  "semantic_models": [
    {
      "name": "orders",
      "defaults": {
        "agg_time_dimension": "ordered_at"
      },
      "description": "One row per order",
      "node_relation": {
        "alias": "orders",
        "schema_name": "main",
        "relation_name": "main.orders"
      },
      "entities": [
        {
          "name": "order",
          "type": "primary",
          "expr": "order_id"
        },
        {
          "name": "customer",
          "type": "foreign",
          "expr": "customer_id"
        }
      ],
      "measures": [
        {
          "name": "order_total",
          "agg": "sum",
          "description": "Sum of order amounts",
          "expr": "amount"
        },
        {
          "name": "order_count",
          "agg": "sum",
          "expr": "1"
        }
