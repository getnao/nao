          }
        },
        {
          "name": "status",
          "description": "Order status",
          "type": "categorical",
          "is_partition": false
        }
      ]
    }
  ],
  "metrics": [
    {
      "name": "revenue",
      "description": "Total revenue from orders",
      "type": "simple",
      "type_params": {
        "measure": {
          "name": "order_total",
          "join_to_timespine": false
        },
        "expr": "amount",
        "input_measures": [
          {
            "name": "order_total",
            "join_to_timespine": false
          }
