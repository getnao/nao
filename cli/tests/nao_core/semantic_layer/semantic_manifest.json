      "type_params": {
        "measure": {
          "name": "order_count",
          "join_to_timespine": false
        },
        "expr": "1",
        "input_measures": [
          {
            "name": "order_count",
            "join_to_timespine": false
          }
        ],
        "metric_aggregation_params": {
          "semantic_model": "orders",
          "agg": "sum"
        },
        "join_to_timespine": false,
        "is_private": false
      }
    },
    {
      "name": "average_order_value",
      "description": "Revenue divided by orders",
      "type": "ratio",
      "type_params": {
        "numerator": {
