# Edge proxy for the GCP VM hosting moon, licenses, app and labs.
# Caddy issues and renews the TLS certificate of every site block automatically
# (HTTP-01 / TLS-ALPN-01), so adding a site only needs a DNS record and a block here.
# Deployed by .github/workflows/caddy.yml.

# Blue/green upstreams for moon and app: each runs on two ports and only one container is live
# outside of a deploy. `first` sends every request to the first healthy port, and a
# draining container fails /api/health so traffic moves before it stops.
(blue_green) {
	lb_policy first
	lb_try_duration 30s
	health_uri /api/health
	health_interval 2s
	health_timeout 2s
}

# Access log read by the telemetry agent (otel-collector/config.yaml). It goes to the data
# volume because the agent cannot discover the logs of a container on the host network.
(access_log) {
	log {
		output file /data/logs/access.log {
			roll_size 50MiB
			roll_keep 3
		}
		format filter {
			request>uri query {
				replace code REDACTED
				replace token REDACTED
				replace state REDACTED
			}
		}
	}
}

moon.getnao.io {
	import access_log
	reverse_proxy localhost:5005 localhost:5006 {
		import blue_green
		flush_interval -1
	}
}

licenses.getnao.io {
	import access_log
	encode zstd gzip

	@error_ingest path /api/errors /api/errors/*
	handle @error_ingest {
		@not_post not method POST
		respond @not_post "Method Not Allowed" 405

		request_body {
			max_size 32KB
		}

		reverse_proxy 127.0.0.1:8585 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8585 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
}

app.getnao.io {
	import access_log
	@backoffice path /api/backoffice/*
	handle @backoffice {
		respond 404
	}
	handle {
		reverse_proxy localhost:5050 localhost:5051 {
			import blue_green
			flush_interval -1
		}
	}
}

labs.getnao.io {
	import access_log
	reverse_proxy localhost:5015
}

app.preview.getnao.io {
	redir https://app.getnao.io{uri} permanent
}
